# Google Places API Key (Optional but recommended for exact Google Maps data)
# Get a key from: https://console.cloud.google.com/ (Search for Places API)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Gemini API Key (Optional for AI summaries, falls back to Places key if provided)
GEMINI_API_KEY=your_gemini_api_key_here
